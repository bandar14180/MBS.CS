{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "MBS.CS Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "MBS.CS - AI Operations",
  "description": "AI-2.5: AI spend, throughput, latency (p50/p95), error rate, failover, and budget blocks. Import as an artifact; no Grafana service is bundled.",
  "tags": ["mbs", "ai"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "AI spend rate (USD/hr) by model",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(mbs_ai_cost_usd_total[5m])) by (model) * 3600", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 2,
      "title": "AI calls/min by agent role",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "cpm" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(mbs_ai_calls_total[5m])) by (agent_role) * 60", "legendFormat": "{{agent_role}}" }
      ]
    },
    {
      "id": 3,
      "title": "AI tokens/min by direction",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(mbs_ai_tokens_total[5m])) by (direction) * 60", "legendFormat": "{{direction}}" }
      ]
    },
    {
      "id": 4,
      "title": "AI latency (p50 / p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(mbs_ai_latency_seconds_bucket[10m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(mbs_ai_latency_seconds_bucket[10m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 5,
      "title": "AI error rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(mbs_ai_errors_total[15m])) / clamp_min(sum(rate(mbs_ai_calls_total[15m])) + sum(rate(mbs_ai_errors_total[15m])), 0.001)", "legendFormat": "error rate" }
      ]
    },
    {
      "id": 6,
      "title": "Provider failover / budget blocks (15m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(increase(mbs_ai_failover_total[15m]))", "legendFormat": "failovers" },
        { "refId": "B", "expr": "sum(increase(mbs_ai_budget_blocked_total[15m]))", "legendFormat": "budget blocks" }
      ]
    }
  ]
}
