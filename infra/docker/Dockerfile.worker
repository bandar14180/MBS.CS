FROM python:3.12-slim

WORKDIR /srv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Security tool binaries (recon phase per build order §12). Versions are pinned
# to match each runner's `.version` in scanner_engine/tool_runners/. The three
# ProjectDiscovery tools (naabu/subfinder/httpx) install the same way (release
# zip). httpx is renamed to `httpx-pd` to avoid colliding with the Python httpx
# library on PATH. nmap comes from apt. libpcap0.8 is only needed for naabu SYN
# scans (we default to connect scans, no root) but is kept for future use.
ARG NAABU_VERSION=2.6.1
ARG SUBFINDER_VERSION=2.14.0
ARG HTTPX_VERSION=1.10.0
ARG NUCLEI_VERSION=3.11.0
# Local TLS-interception support (BUILD-TIME ONLY) -- applied to every HTTPS step
# in this file (curl -> GitHub, pip -> PyPI, nuclei -> template repo).
# Where an AV/proxy terminates TLS (e.g. Norton), those hosts present a locally-
# signed cert. The root is passed as an OPTIONAL BuildKit secret:
#   local: docker build --secret id=extra_ca,src=infra/docker/norton-webmail-root.crt ...
#   CI/prod: no secret passed -> public CAs only; the image trusts nothing extra.
# The combined bundle lives in /tmp for the duration of each layer and is deleted
# before that layer is committed, so the interception root never ships in the image.
# TLS verification is never disabled (no --trusted-host, no -k, no SSL bypass).
# NOTE: pip ignores the system trust store (vendored certifi), hence PIP_CERT.
RUN --mount=type=secret,id=extra_ca \
    if [ -f /run/secrets/extra_ca ]; then \
        cat /etc/ssl/certs/ca-certificates.crt /run/secrets/extra_ca > /tmp/ca-build.pem; \
        export CURL_CA_BUNDLE=/tmp/ca-build.pem SSL_CERT_FILE=/tmp/ca-build.pem \
               PIP_CERT=/tmp/ca-build.pem REQUESTS_CA_BUNDLE=/tmp/ca-build.pem; \
    fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip libpcap0.8 nmap \
       postgresql-client-17 \
    && curl -sSfL "https://github.com/projectdiscovery/naabu/releases/download/v${NAABU_VERSION}/naabu_${NAABU_VERSION}_linux_amd64.zip" -o /tmp/naabu.zip \
    && unzip -o /tmp/naabu.zip -d /tmp/naabu && mv /tmp/naabu/naabu /usr/local/bin/naabu \
    && curl -sSfL "https://github.com/projectdiscovery/subfinder/releases/download/v${SUBFINDER_VERSION}/subfinder_${SUBFINDER_VERSION}_linux_amd64.zip" -o /tmp/subfinder.zip \
    && unzip -o /tmp/subfinder.zip -d /tmp/subfinder && mv /tmp/subfinder/subfinder /usr/local/bin/subfinder \
    && curl -sSfL "https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_VERSION}/httpx_${HTTPX_VERSION}_linux_amd64.zip" -o /tmp/httpx.zip \
    && unzip -o /tmp/httpx.zip -d /tmp/httpx && mv /tmp/httpx/httpx /usr/local/bin/httpx-pd \
    && curl -sSfL "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_amd64.zip" -o /tmp/nuclei.zip \
    && unzip -o /tmp/nuclei.zip -d /tmp/nuclei && mv /tmp/nuclei/nuclei /usr/local/bin/nuclei \
    && chmod +x /usr/local/bin/naabu /usr/local/bin/subfinder /usr/local/bin/httpx-pd /usr/local/bin/nuclei \
    && rm -rf /tmp/naabu* /tmp/subfinder* /tmp/httpx* /tmp/nuclei* \
    && apt-get purge -y curl unzip \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /tmp/ca-build.pem

COPY apps/api/requirements.txt ./apps/api/requirements.txt
# PyPI over HTTPS -- same optional-secret pattern as above.
RUN --mount=type=secret,id=extra_ca \
    if [ -f /run/secrets/extra_ca ]; then \
        cat /etc/ssl/certs/ca-certificates.crt /run/secrets/extra_ca > /tmp/ca-build.pem; \
        export PIP_CERT=/tmp/ca-build.pem SSL_CERT_FILE=/tmp/ca-build.pem \
               REQUESTS_CA_BUNDLE=/tmp/ca-build.pem; \
    fi; \
    pip install --no-cache-dir -r apps/api/requirements.txt \
    && rm -f /tmp/ca-build.pem

# Run scans as an unprivileged user. The default recon config uses connect scans
# (naabu/nmap) which do NOT need root/raw sockets, so no capabilities are lost.
# DR-1: create BACKUP_DIRECTORY here, owned by appuser, BEFORE dropping privileges.
# The named volume mounted at /srv/backups inherits this ownership the first time it
# is used (Docker seeds an empty named volume from the image directory), so the
# unprivileged runtime user can write backup sets. Without it the mount lands
# root-owned 0755 and `dr backup` fails with PermissionError.
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /srv/backups \
    && chown appuser:appuser /srv/backups
USER appuser

# Docker does NOT reset $HOME when USER changes -- it stays at the builder default
# (/root), so `nuclei -update-templates` below would write templates into a dir
# the runtime appuser cannot read. Pin HOME to appuser's home so templates install
# exactly where the runtime user's nuclei looks. NUCLEI_TEMPLATES_DIR is read by
# the nuclei runner (via Settings) so template discovery never depends on ambient
# $HOME at scan time either.
ENV HOME=/home/appuser \
    NUCLEI_TEMPLATES_DIR=/home/appuser/nuclei-templates

# Bake the Nuclei template set into the image so scans don't depend on GitHub
# egress at runtime. Fail the build if templates did not land, readable, under
# appuser's HOME -- an image that cannot vuln-scan is not fit to ship (no `|| true`).
# This sits BEFORE the app COPY so iterating on application code doesn't bust the
# (large, slow) template layer.
# GitHub over HTTPS -- same optional-secret pattern. `uid=10001` is required here
# because this layer runs as appuser and the secret is root-owned 0400 by default.
# Go/Python read SSL_CERT_FILE for their trust store, so the fetch honors the bundle.
#
# `nuclei -update-templates` is NOT used: on 3.11.0 it can exit 0 while installing
# NOTHING (download succeeds, extraction fails silently), which defeats the count
# gate below by leaving an empty dir behind a successful exit. Fetching the pinned
# release archive directly is deterministic instead: the version is an ARG (an
# upgrade becomes a reviewed repo change rather than a silent drift), a truncated
# download raises BadZipFile, and `set -eu` aborts the layer on any failure.
ARG NUCLEI_TEMPLATES_VERSION=10.4.7
RUN --mount=type=secret,id=extra_ca,uid=10001 <<'SH'
set -eu
if [ -f /run/secrets/extra_ca ]; then
    cat /etc/ssl/certs/ca-certificates.crt /run/secrets/extra_ca > /tmp/ca-build.pem
    export SSL_CERT_FILE=/tmp/ca-build.pem
fi
python - "$NUCLEI_TEMPLATES_DIR" "$NUCLEI_TEMPLATES_VERSION" <<'PY'
import http.client, io, os, ssl, sys, time, urllib.request, zipfile

dest, ver = sys.argv[1], sys.argv[2]
url = f"https://codeload.github.com/projectdiscovery/nuclei-templates/zip/refs/tags/v{ver}"
ctx = ssl.create_default_context(cafile=os.environ.get("SSL_CERT_FILE") or None)

# A TLS-intercepting proxy can sever this ~19MB transfer mid-stream (IncompleteRead),
# intermittently rather than deterministically. Retry the WHOLE download up to 3 times;
# each attempt discards its partial buffer, so a truncated body is never reused or
# written to disk. After the last attempt the exception propagates and fails the build.
ATTEMPTS = 3
for attempt in range(1, ATTEMPTS + 1):
    data = None                              # drop any partial buffer from a failed try
    try:
        with urllib.request.urlopen(
            urllib.request.Request(url, headers={"User-Agent": "nuclei"}), context=ctx, timeout=300
        ) as r:
            data = r.read()
        expected = r.headers.get("Content-Length")
        if expected is not None and len(data) != int(expected):
            raise OSError(f"short read: got {len(data)} of {expected} bytes")
        break
    except (http.client.IncompleteRead, OSError, ssl.SSLError) as exc:
        data = None
        print(f"attempt {attempt}/{ATTEMPTS} failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        if attempt == ATTEMPTS:
            raise
        time.sleep(5 * attempt)               # brief, widening pause before retrying

z = zipfile.ZipFile(io.BytesIO(data))       # truncated archive -> BadZipFile -> build fails
root = z.namelist()[0].split("/")[0]        # strip the "nuclei-templates-<ver>/" prefix
os.makedirs(dest, exist_ok=True)
for m in z.infolist():
    rel = m.filename[len(root) + 1:]
    if not rel:
        continue
    target = os.path.join(dest, rel)
    if m.is_dir():
        os.makedirs(target, exist_ok=True)
        continue
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with z.open(m) as src, open(target, "wb") as dst:
        dst.write(src.read())
print(f"extracted {len(z.infolist())} entries -> {dest}")
PY
[ "$(find "$NUCLEI_TEMPLATES_DIR" -name '*.yaml' 2>/dev/null | wc -l)" -gt 100 ]
rm -f /tmp/ca-build.pem
SH

# DAST enhancement: the app-layer coverage the signature pipeline lacks.
#   katana  -- crawler (release zip), feeds discovered URLs to the fuzzer.
#   arjun   -- HTTP parameter discovery (pip), turns crawled endpoint paths into
#              fuzzable param URLs so nuclei-dast can inject SQLi/XSS/LFI probes.
# Installed as their OWN layer AFTER the slow nuclei-templates layer so adding
# them never busts that (large) cache. Needs root for /usr/local/bin + site-packages.
USER root
ARG KATANA_VERSION=1.1.2
# GitHub (katana) + PyPI (arjun) over HTTPS -- same optional-secret pattern.
RUN --mount=type=secret,id=extra_ca \
    if [ -f /run/secrets/extra_ca ]; then \
        cat /etc/ssl/certs/ca-certificates.crt /run/secrets/extra_ca > /tmp/ca-build.pem; \
        export CURL_CA_BUNDLE=/tmp/ca-build.pem SSL_CERT_FILE=/tmp/ca-build.pem \
               PIP_CERT=/tmp/ca-build.pem REQUESTS_CA_BUNDLE=/tmp/ca-build.pem; \
    fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends curl unzip \
    && curl -sSfL "https://github.com/projectdiscovery/katana/releases/download/v${KATANA_VERSION}/katana_${KATANA_VERSION}_linux_amd64.zip" -o /tmp/katana.zip \
    && unzip -o /tmp/katana.zip -d /tmp/katana && mv /tmp/katana/katana /usr/local/bin/katana \
    && chmod +x /usr/local/bin/katana \
    && rm -rf /tmp/katana* \
    && pip install --no-cache-dir arjun==2.2.7 \
    && apt-get purge -y curl unzip && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* \
    && rm -f /tmp/ca-build.pem
USER appuser

# Warm httpx's tech-detection ("dit") model into the image so scans don't download
# ~92MB at runtime (P2-15). Best-effort: if the build network can't fetch it, we
# fall back to the runtime download (unchanged behavior) rather than failing.
RUN --mount=type=secret,id=extra_ca,uid=10001 \
    if [ -f /run/secrets/extra_ca ]; then \
        cat /etc/ssl/certs/ca-certificates.crt /run/secrets/extra_ca > /tmp/ca-build.pem; \
        export SSL_CERT_FILE=/tmp/ca-build.pem; \
    fi; \
    echo "https://example.com" | httpx-pd -tech-detect -silent -timeout 20 >/dev/null 2>&1 || true; \
    rm -f /tmp/ca-build.pem

# Application code last: it changes most often, so keeping it after the template
# layer keeps rebuilds fast. Owned by the runtime user (COPY runs as root).
COPY --chown=appuser:appuser apps/__init__.py ./apps/__init__.py
COPY --chown=appuser:appuser apps/api ./apps/api

CMD ["celery", "-A", "apps.api.celery_app.worker.celery_app", "worker", "--loglevel=info"]
