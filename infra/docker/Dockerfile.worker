FROM python:3.12-slim

WORKDIR /srv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Security tool binaries (recon phase per build order §12). Versions are pinned
# to match each runner's `.version` in scanner_engine/tool_runners/. The three
# ProjectDiscovery tools (naabu/subfinder/httpx) install the same way (release
# zip). httpx is renamed to `httpx-pd` to avoid colliding with the Python httpx
# library on PATH. nmap comes from apt. libpcap0.8 is only needed for naabu SYN
# scans (we default to connect scans, no root) but is kept for future use.
ARG NAABU_VERSION=2.6.1
ARG SUBFINDER_VERSION=2.14.0
ARG HTTPX_VERSION=1.10.0
ARG NUCLEI_VERSION=3.11.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip libpcap0.8 nmap \
    && curl -sSfL "https://github.com/projectdiscovery/naabu/releases/download/v${NAABU_VERSION}/naabu_${NAABU_VERSION}_linux_amd64.zip" -o /tmp/naabu.zip \
    && unzip -o /tmp/naabu.zip -d /tmp/naabu && mv /tmp/naabu/naabu /usr/local/bin/naabu \
    && curl -sSfL "https://github.com/projectdiscovery/subfinder/releases/download/v${SUBFINDER_VERSION}/subfinder_${SUBFINDER_VERSION}_linux_amd64.zip" -o /tmp/subfinder.zip \
    && unzip -o /tmp/subfinder.zip -d /tmp/subfinder && mv /tmp/subfinder/subfinder /usr/local/bin/subfinder \
    && curl -sSfL "https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_VERSION}/httpx_${HTTPX_VERSION}_linux_amd64.zip" -o /tmp/httpx.zip \
    && unzip -o /tmp/httpx.zip -d /tmp/httpx && mv /tmp/httpx/httpx /usr/local/bin/httpx-pd \
    && curl -sSfL "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_amd64.zip" -o /tmp/nuclei.zip \
    && unzip -o /tmp/nuclei.zip -d /tmp/nuclei && mv /tmp/nuclei/nuclei /usr/local/bin/nuclei \
    && chmod +x /usr/local/bin/naabu /usr/local/bin/subfinder /usr/local/bin/httpx-pd /usr/local/bin/nuclei \
    && rm -rf /tmp/naabu* /tmp/subfinder* /tmp/httpx* /tmp/nuclei* \
    && apt-get purge -y curl unzip \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt ./apps/api/requirements.txt
RUN pip install --no-cache-dir -r apps/api/requirements.txt

COPY apps/__init__.py ./apps/__init__.py
COPY apps/api ./apps/api

# Run scans as an unprivileged user. The default recon config uses connect scans
# (naabu/nmap) which do NOT need root/raw sockets, so no capabilities are lost.
RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /srv
USER appuser

# Bake the Nuclei template set into the image so scans don't depend on GitHub
# egress at runtime. Run AS appuser so templates install under the runtime user's
# HOME (~/nuclei-templates), which is where nuclei's default discovery looks. No
# `|| true`: if this can't fetch templates, the image is not fit for vuln scans.
RUN nuclei -update-templates

CMD ["celery", "-A", "apps.api.celery_app.worker.celery_app", "worker", "--loglevel=info"]
