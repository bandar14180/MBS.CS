# AUDIT-005: base image pinned by IMMUTABLE DIGEST. A tag is a moving pointer the registry
# can repoint at any time, so a rebuild months later would silently produce a different
# base than the one that was tested and scanned. Verified real: python:3.12-slim had
# ALREADY drifted -- the local image and the registry tag resolved to different digests.
# Tag kept in the comment for readability. To update, run:
#   docker buildx imagetools inspect <image>:<tag>
# python:3.12-slim
FROM python@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

WORKDIR /srv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UVICORN_WORKERS=2

COPY apps/api/requirements.txt ./apps/api/requirements.txt

# Local TLS-interception support (BUILD-TIME ONLY).
# Where an AV/proxy terminates TLS (e.g. Norton), PyPI presents a locally-signed
# cert and pip fails with "unable to get local issuer certificate". Trusting the
# root system-wide is NOT enough: pip ignores the system store and uses its own
# vendored certifi bundle, so it needs PIP_CERT pointed at a bundle that includes
# the local root.
#
# The root is an OPTIONAL BuildKit secret:
#   local: docker build --secret id=extra_ca,src=infra/docker/norton-webmail-root.crt ...
#   CI/prod: no secret passed -> public CAs only; the image trusts nothing extra.
# The combined bundle exists in /tmp for THIS layer only and is deleted before the
# layer is committed, so the interception root never reaches the final image.
# TLS verification is never disabled (no --trusted-host, no SSL bypass).
RUN --mount=type=secret,id=extra_ca \
    if [ -f /run/secrets/extra_ca ]; then \
        cat /etc/ssl/certs/ca-certificates.crt /run/secrets/extra_ca > /tmp/ca-build.pem; \
        export PIP_CERT=/tmp/ca-build.pem SSL_CERT_FILE=/tmp/ca-build.pem \
               REQUESTS_CA_BUNDLE=/tmp/ca-build.pem CURL_CA_BUNDLE=/tmp/ca-build.pem; \
    fi; \
    pip install --no-cache-dir -r apps/api/requirements.txt \
    && rm -f /tmp/ca-build.pem

COPY apps/__init__.py ./apps/__init__.py
COPY apps/api ./apps/api

COPY infra/docker/api_healthcheck.py /usr/local/bin/api_healthcheck.py

# Run as an unprivileged user (defense in depth for the internet-facing service).
RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /srv
USER appuser

EXPOSE 8000

# Liveness probe. Stdlib only (the runtime image ships no curl/wget), no DNS, no external
# service -- it connects to 127.0.0.1 inside this container.
#
# The probe MUST send a Host the app's TrustedHostMiddleware accepts. The previous one-liner
# called urlopen('http://localhost:8000/health'), i.e. `Host: localhost:8000`, which a
# production TRUSTED_HOSTS of ["mbs.example.com"] rejects with 400 BEFORE the route runs --
# so Docker reported a healthy API as `unhealthy`. api_healthcheck.py derives the Host from
# the SAME TRUSTED_HOSTS value the app is configured with (so the two can never drift) and
# still traverses the full middleware stack. See that file for the measured evidence and for
# why /health (liveness) is correct here rather than /ready (readiness).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "/usr/local/bin/api_healthcheck.py"]

# Production default: no --reload, multiple workers. The dev compose override
# replaces this with a hot-reloading single-worker command.
#
# `exec` (Phase 1.5): uvicorn REPLACES the shell and becomes PID 1, so Docker's SIGTERM
# reaches uvicorn directly and it drains in-flight requests gracefully on `docker stop`.
# Without exec, `sh` is PID 1 and does not forward SIGTERM -> uvicorn is SIGKILLed and
# in-flight requests are dropped. The shell is still needed to expand ${UVICORN_WORKERS}.
CMD ["sh", "-c", "exec uvicorn apps.api.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-2}"]
