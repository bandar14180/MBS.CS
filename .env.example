# Copy this file to .env and fill in real values before running docker compose.

ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://mbs:mbs@postgres:5432/mbs
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_EVIDENCE=mbs-evidence
S3_BUCKET_REPORTS=mbs-reports

JWT_SECRET_KEY=change-me-generate-a-real-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

ANTHROPIC_API_KEY=

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost","http://127.0.0.1:3000","http://127.0.0.1"]
