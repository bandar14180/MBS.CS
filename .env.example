# Copy this file to .env and fill in real values.
#
# THIS FILE IS FOR LOCAL DEVELOPMENT. In production none of the credentials here are used:
# infra/docker-compose.prod.yml delivers every secret as a Docker Secret via the `<NAME>_FILE`
# convention, and core/config.py resolves those files with PRECEDENCE OVER the values inherited
# from this file -- so a stale entry here cannot silently defeat a mounted secret. Generating the
# secret files is documented in docs/runbooks/deployment.md.

ENVIRONMENT=development

# --- Database (Phase 0 MySQL cutover) --------------------------------------------------------
# Two ways to point the app at MySQL -- pick ONE, the other must stay commented out (an explicit
# DATABASE_URL always wins over the DB_* parts below; see
# apps/api/core/config.py:_resolve_database_url_from_parts).
#
# (1) DISCRETE PARTS -- active by default below. Use this if you created the database yourself
#     (e.g. by hand in MySQL Workbench) and think in terms of host/port/user/password/db name
#     rather than a connection URL. The app assembles these into a DATABASE_URL at startup.
#     Fill in whatever you actually created in Workbench -- these are just placeholders.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mbs
DB_USER=mbs
DB_PASSWORD=mbs
#
# (2) SINGLE URL -- what infra/docker-compose.yml uses (host `mysql` is the compose service
#     name, only resolvable inside that docker network). Uncomment this AND comment out the
#     DB_* lines above if you're running via `docker compose up` instead of locally.
# DATABASE_URL=mysql+aiomysql://mbs:mbs@mysql:3306/mbs

# Running the test suite (apps/api/tests) locally against your own MySQL: point DB_NAME (or
# DATABASE_URL) at a database whose name ends in `_test`, e.g. DB_NAME=mbs_test, created
# separately from your real `mbs` database. The suite DELETEs every row in every app table
# before each test (apps/api/tests/conftest.py's `_reset_db` fixture) -- the `_test` suffix is
# what lets it run without also requiring MBS_ALLOW_DB_WIPE=1. Create it once in Workbench:
#   CREATE DATABASE mbs_test;
#   GRANT ALL PRIVILEGES ON mbs_test.* TO 'mbs'@'%';  -- or whatever DB_USER you set above
# and also see the transaction-isolation note in docs/runbooks or infra/docker-compose.yml's
# mysql service comment -- MySQL's REPEATABLE READ default vs this codebase's READ COMMITTED
# assumption; apps/api/core/db.py sets it per-connection for the app's own engines, but a
# server-wide `SET GLOBAL transaction_isolation='READ-COMMITTED';` (run once in Workbench) keeps
# ad-hoc test engines consistent too.

# --- Redis (optional) -------------------------------------------------------------------------
# Only used for the rate limiter and MFA lockout, and both are fail-open: if Redis is
# unreachable they log a warning and allow the request rather than blocking it (see
# apps/api/core/middleware.py and apps/api/modules/auth/mfa_guard.py). Not required to run the
# app or most of the test suite locally -- leave unset if you don't have Redis running, or point
# it at a local instance if you do.
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Object storage / S3 (optional) -----------------------------------------------------------
# Only needed for evidence upload + report file storage -- everything else (including MySQL
# connectivity and most of the test suite) works without it. Leave commented out unless you're
# running MinIO (or another S3-compatible store) locally; the class defaults below point at the
# docker-compose `minio` service, which won't resolve outside that network.
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_EVIDENCE=mbs-evidence
# S3_BUCKET_REPORTS=mbs-reports

JWT_SECRET_KEY=change-me-generate-a-real-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# --- AI providers ------------------------------------------------------------------------------
# EVERY key below is read from the environment only -- never hardcode one in source, compose, or
# CI. All default to empty: with no key set the AI features degrade gracefully (disabled), they
# do not fail the app. In production these arrive as Docker Secrets via the `<NAME>_FILE`
# convention (see infra/docker-compose.prod.yml), which takes precedence over anything here.
#
# Which provider the AI layer uses: openrouter | anthropic | local | deepseek.
# AI_PROVIDER=openrouter

# --- AI spend cap (F-06) ---------------------------------------------------------------------
# REQUIRED IN PRODUCTION whenever a METERED provider (openrouter / anthropic / deepseek) has a
# live API key: the app REFUSES TO START without both of these. RATE_LIMIT_AI bounds request
# RATE, never COST, so without a cap a runaway agent loop or an abusive tenant can bill without
# limit. BOTH are needed -- enforcement with a zero cap is inert, and a cap nothing enforces
# does nothing. Per-workspace rolling DAILY estimated spend, tracked in Redis; on reaching the
# cap that workspace's AI calls degrade through the existing contract (assistant -> 503,
# agent -> finish). Not required for AI_PROVIDER=local (self-hosted Ollama has no per-token cost).
# AI_BUDGET_ENFORCE=true
# AI_DAILY_BUDGET_USD=25

# Anthropic (direct). Leave the key empty here and put the real value in your local .env only.
#
# NOTE ON THE MODEL VARIABLE NAME: the Anthropic model id is configurable, but the setting is
# `ai_model`, so the environment variable is AI_MODEL -- NOT "ANTHROPIC_MODEL". Settings defines
# no alias for it (apps/api/core/config.py), and `extra="ignore"` means a stray ANTHROPIC_MODEL
# would be silently dropped rather than rejected. The model is read from settings at the call
# site (ai_agent/providers/anthropic.py), never hardcoded.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-4-8

# OpenRouter (the default primary provider). OPENROUTER_MODEL is a slug from
# https://openrouter.ai/models.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=anthropic/claude-opus-4.1

# DeepSeek (OpenAI-compatible, cloud).
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Ordered SECONDARY providers tried only on an availability failure. [] = off.
# AI_FALLBACK_PROVIDERS=["anthropic","deepseek"]

# --- AI: self-hosted, no API key (apps/api/ai_agent/providers/local.py) -----------------------
# Want AI features (remediation generation, the assistant, AI planning) without any external API
# key? Uncomment these three lines. AI_PROVIDER=local talks to the `ollama` compose service
# (infra/docker-compose.yml) over its OpenAI-compatible endpoint -- no egress, scan data never
# leaves this machine. `ollama-init` pulls OLLAMA_MODEL into a persistent volume on
# `docker compose up` (a few GB the first time; a no-op after). Left commented so a fresh
# checkout doesn't force that download by default -- AI simply stays disabled (graceful
# degradation) until you opt in here or set a real provider's API key above.
# AI_PROVIDER=local
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_MODEL=llama3.2:3b

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost","http://127.0.0.1:3000","http://127.0.0.1"]

# Number of proxies in front of the app that APPEND to X-Forwarded-For; the client's own hop is
# read as the Nth entry from the right. Only affects the rate-limit bucket for anonymous requests.
# 0 = nothing in front (X-Forwarded-For ignored, direct peer used) -- the safe default for local
# dev. PRODUCTION MUST SET THIS EXPLICITLY (the app refuses to start otherwise) and must never
# guess it: determine the real hop count, and do not use a non-zero value while the API port is
# directly reachable. See docs/runbooks/deployment.md.
#
# NOTE FOR PRODUCTION: setting it HERE has no effect. infra/docker-compose.prod.yml declares it
# in the api service's `environment:` mapping, which overrides this file (loaded as `env_file`),
# so the production value must be changed there. It ships as "1" -- correct for the bundled
# nginx-only topology; recount it if anything else fronts the app.
# TRUSTED_PROXY_COUNT=0

# --- Local development convenience ---------------------------------------------------------
# Skips the manual "submit ownership proof, then have an owner verify it" authorization-scope
# flow (Targets tab) -- a scan (including active-testing modules like nuclei) is allowed
# against ANY target the instant it's requested. Only for iterating against infrastructure you
# already own on a local dev database. NEVER set this for a real engagement.
#
# F-05: the app REFUSES TO START with this enabled unless ENVIRONMENT is explicitly one of
# development / dev / local / test / testing. It is not enough that the environment "isn't
# production" -- staging, prod, qa, or a typo like " production" are all refused, because an
# unrecognised environment name is treated as a real deployment (fail closed).
# DEV_AUTO_AUTHORIZE_TARGETS=true

# --- Other secrets (all empty by default; set only in your local .env) -------------------------
# Bearer token guarding the /metrics endpoint. Empty = endpoint stays closed.
# METRICS_TOKEN=
# Master secret used to derive the Fernet key that encrypts each user's TOTP secret at rest.
# MFA_ENCRYPTION_KEY=
# Backup encryption (DR-2) and off-site replication (DR-3) -- only needed when enabled.
# BACKUP_ENCRYPTION_KEY=
# BACKUP_OFFSITE_SECRET_KEY=
# SMTP password for email alerts.
# SMTP_PASSWORD=

# --- MBS.SC: private network scanning -------------------------------------------------
# THE OUTER SAFETY BOUNDARY ONLY. Since the per-scan network policy landed, these two no
# longer authorize anybody by themselves: they set a platform-wide CEILING, and a scan
# additionally needs its own persisted authorization chain
# (workspace -> private site -> authorized CIDRs). Turning this on therefore grants
# nothing; it only stops forbidding. Leaving it false disables private scanning outright,
# whatever any tenant has configured.
#
# Historical note (why the wording matters): these settings USED to be the entire
# decision, which meant enabling them for one on-prem customer authorized every tenant in
# the deployment for every listed CIDR. See docs/architecture/scanner-isolation.md.
# SCAN_ALLOW_PRIVATE_TARGETS=false
# SCAN_ALLOWED_CIDRS=["10.0.0.0/8"]
#
# Emergency kill switch: stops ALL private scanning platform-wide, enforced by the
# scanner-manager (control-plane side), so it works even for a scanner host that is
# compromised or unreachable.
# PRIVATE_SCANNING_EMERGENCY_DISABLE=false
#
# The scanner EXECUTION plane has its own, deliberately minimal env file --
# see .env.scanner.example. Do NOT add database/broker/object-store/JWT/AI credentials
# there: a compose overlay cannot unset an env_file variable, so anything added to the
# scanner's env file is reachable by a compromised scanner.
