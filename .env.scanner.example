# MBS.SC -- SCANNER EXECUTION PLANE ENVIRONMENT (Property B: credential minimization)
#
# This file exists because of a structural property of Docker Compose: a compose overlay
# CANNOT unset a variable that came from an `env_file`. The scanner worker previously
# loaded the same flat `../.env` as the API, which meant the process that executes
# untrusted scanner binaries against customer infrastructure held:
#
#   DATABASE_URL / DB_PASSWORD  -> full read/write on every tenant's data
#   REDIS_URL                   -> broker access: forge/pop other tenants' tasks
#   S3_ACCESS_KEY / S3_SECRET_KEY (MinIO root) -> all evidence, all reports
#   JWT_SECRET_KEY              -> MINT A VALID TOKEN FOR ANY USER IN ANY WORKSPACE
#   OPENROUTER_API_KEY / ANTHROPIC_API_KEY     -> billable third-party credential
#
# None of those are required to run nmap. The only way to withhold them is to never load
# the control-plane env file into this service -- hence this separate, minimal file.
#
# Copy to `.env.scanner` next to `.env`. ADD NOTHING TO THIS FILE THAT THE EXECUTION
# PLANE DOES NOT STRICTLY NEED. Every variable here is reachable by a compromised scanner.

# --- Identity ---------------------------------------------------------------------
# Who this worker is. The manager authorizes every request against this identity; it is
# NOT a bearer credential for the control plane and grants nothing on its own.
SCANNER_WORKER_ID=
SCANNER_POOL_ID=public-default
# Set ONLY on a private (per-site) worker. Binds this worker to exactly one private site.
SCANNER_SITE_ID=

# --- Manager boundary -------------------------------------------------------------
# The ONLY control-plane endpoint the execution plane may speak to (mbs-dispatch).
SCANNER_MANAGER_URL=http://scanner-manager:8100
# Shared-secret bootstrap credential for this ONE worker. Scoped to this worker_id only:
# presenting it authorizes nothing beyond this worker's own pool/site.
SCANNER_WORKER_TOKEN=

# --- Execution mode ---------------------------------------------------------------
# Makes the execution plane refuse to start if control-plane credentials are present
# (startup_security). Keep this true on every scanner worker.
SCANNER_EXECUTION_PLANE=true
ENVIRONMENT=production

# --- Screenshot evidence ------------------------------------------------------------
# Capture the affected page for non-info web findings, on the EXECUTION plane, where
# egress to customer targets is already permitted (mbs-scan-egress). The scanner-manager
# sits on the control plane and must never do this -- see scanner_manager/app.py, which
# calls ingest_vulnerability_findings(capture_screenshots=False).
#
# Requires Playwright + Chromium, which are present in the worker image only
# (requirements-worker.txt / Dockerfile.worker). Capture is best effort and stays fully
# gated by the existing 5-gate eligibility model in scanner_engine/screenshot.py
# (severity -> http/https scheme -> hostname -> scope_guard -> net_guard SSRF).
SCREENSHOT_EVIDENCE_ENABLED=true
